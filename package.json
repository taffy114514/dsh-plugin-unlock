{
  "name": "dsh-plugin-unlock",
  "version": "0.2.2",
  "description": "释放 DSH 里被卡在「正在使用中」状态的插件，让桌面端市场能重新更新或卸载它们。",
  "type": "module",
  "license": "MIT",
  "author": "YG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taffy114514/dsh-plugin-unlock.git"
  },
  "homepage": "https://github.com/taffy114514/dsh-plugin-unlock#readme",
  "bugs": {
    "url": "https://github.com/taffy114514/dsh-plugin-unlock/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin-manager",
    "bundle-in-use"
  ],
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
